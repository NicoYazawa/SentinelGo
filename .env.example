# Generate a new random signing key of at least 32 bytes.
KS_JWT_SECRET=
# Temporary credential only for first installation (12-72 bytes).
# First login requires setting a formal password. Remove this variable afterward.
KS_BOOTSTRAP_ADMIN_PASSWORD=
# Optional GitHub OAuth configuration; use newly issued credentials.
KS_OAUTH_GITHUB_CLIENT_ID=
KS_OAUTH_GITHUB_CLIENT_SECRET=
KS_OAUTH_GITHUB_HTTP_PROXY=
KS_OAUTH_GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/github/callback
KS_OAUTH_GITHUB_FRONTEND_URL=http://localhost:3001

# Optional: prebuilt GHCR images (docker-compose.release.yml).
# Use lowercase owner/repository and a published version tag.
GHCR_REPOSITORY=
IMAGE_TAG=
